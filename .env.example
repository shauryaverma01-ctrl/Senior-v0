# Senior v0 — environment variable template.
# Copy to .env.local and fill in real values. .env.local is gitignored.

# ─── Supabase ───
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here
TELEGRAM_MANAGER_CHAT_ID=000000000

# ─── Zoronal ───
ZORONAL_WEBHOOK_SECRET=generate-a-random-32-char-string
